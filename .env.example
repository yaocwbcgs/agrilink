# 后端 REST 服务地址。留空时前端使用本地 Mock 数据（演示模式）
VITE_API_BASE_URL=

# AI 病虫害识别服务地址（multipart/form-data）
# 留空时使用演示用「模拟识别」服务，页面会明确标注
VITE_AI_ENDPOINT=

# 行情数据服务地址（预留）
VITE_MARKET_API_URL=

# 地图 / 定位服务 Key（预留）
VITE_MAP_KEY=
